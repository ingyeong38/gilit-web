KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
GEMINI_API_KEY=
SECRET_KEY=

# 백엔드 출발시각 엔진 (backend/app/config.py). backend/.env 또는 이 루트 .env에서 읽는다
# mock | kakao. kakao는 위 KAKAO_REST_API_KEY로 카카오모빌리티 미래 운행 정보 API를 쓴다
ROUTE_PROVIDER=mock
DEPARTURE_MAX_CALLS=8
DEPARTURE_SEARCH_WINDOW_MIN=360
# 카카오 길찾기 응답은 약관상 캐시하지 않는다 (모든 조회를 매번 실시간 호출). 캐시 설정은 없다
# 경로 비교 옵션과 카드 순서 (recommend,time,distance,free 중에서). 비우면 4개 모두
ROUTE_COMPARE_OPTIONS=
# 경로 비교의 옵션 하나당 소요시간 조회 상한
ROUTE_COMPARE_MAX_CALLS=6
# 소요시간 그래프(/api/routes/graph)
# 카드 권장 출발시각 앞·뒤 슬롯 수와 슬롯 간격(분). 기본은 15분 간격 -45~+45분, 카드당 7개 (요청당 최대 13개)
GRAPH_SLOTS_BEFORE=3
GRAPH_SLOTS_AFTER=3
GRAPH_SLOT_INTERVAL_MIN=15
# 요청 하나의 서버 시간 예산(초). 넘으면 받은 점까지만 돌려준다 (프론트 제한 10초보다 짧게)
GRAPH_TIME_BUDGET_SEC=8
# 슬롯 동시 조회 수 (서버 프로세스 전체에서 공유)
GRAPH_MAX_WORKERS=4
# 그래프 전용 일일 카카오 호출 수 (KST 날짜 기준, 프로세스별). 다 쓰면 카카오를 부르지 않고 503
GRAPH_DAILY_CALL_BUDGET=1500
# AI 경로 요약(POST /api/routes/summary). 위 GEMINI_API_KEY와 모델 이름(Google AI Studio의 Gemini 모델 id)을 넣는다
# 키나 모델이 비어 있으면 Gemini를 부르지 않고 서버 규칙 요약(source=rule)을 돌려준다
GEMINI_MODEL=
# Gemini 요청 제한 시간(초). 비우면 6 (프론트 제한 10초보다 짧게)
AI_SUMMARY_TIMEOUT_SEC=
# 웹 API를 부를 수 있는 프론트 출처 (쉼표 구분). 비우면 http://localhost:5500,http://127.0.0.1:5500
# POST·PATCH·DELETE의 출처 검사도 이 목록과 같은 호스트(개발은 http://localhost:8000)만 허용한다
CORS_ORIGINS=

# 회원 인증 (backend/app/auth). 개발 주소는 http://localhost:8000으로 통일한다
# 회원·세션 저장소: memory(기본, 서버를 다시 시작하면 사라짐) | mysql(아래 DB_* 필요)
AUTH_STORE=memory
# 세션 쿠키(gilit_session)의 Secure 속성. 비우면 true. 로컬 http에서 쿠키가 안 실리면 false (운영은 반드시 true)
COOKIE_SECURE=
# SECRET_KEY(맨 위): 서명용 비밀 값. 소셜 로그인(OAuth state 쿠키 서명)에 필수
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"

# 소셜 로그인. 콜백 주소는 {OAUTH_REDIRECT_BASE}/api/auth/{google|kakao}/callback이고 제공자 콘솔에 똑같이 등록한다
# 개발 주소 예: http://localhost:8000 (경로 없이. localhost와 127.0.0.1은 다른 주소로 본다)
OAUTH_REDIRECT_BASE=
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오 로그인: Kakao Developers > 내 애플리케이션 > 앱 키의 REST API 키 / 보안의 Client Secret
# 길찾기용 KAKAO_REST_API_KEY와 같은 앱이면 같은 키를 넣어도 된다. 둘 중 하나만 넣으면 서버가 시작하지 않는다
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
# 1이면 외부 호출 없는 가짜 소셜 로그인 (start가 곧바로 콜백으로 이동). AUTH_STORE=memory에서만 켜진다
OAUTH_MOCK=

# MySQL 접속 정보 (AUTH_STORE=mysql). 로컬 MySQL과 RDS는 이 값만 바꾸면 된다 (db/README.md)
# 계정은 root가 아니라 서비스 계정(gilit_app, SELECT·INSERT·UPDATE·DELETE만)을 쓴다
DB_HOST=
DB_PORT=3306
DB_NAME=gilit
DB_USER=gilit_app
DB_PASSWORD=
# RDS에서 TLS로 연결할 때 CA 번들 경로 (예: C:/certs/global-bundle.pem). 로컬은 비운다
DB_SSL_CA=
# pytest -m mysql_live 전용 DB. 테스트가 회원 데이터를 지우므로 이름이 _test로 끝나야 하고 DB_NAME과 달라야 한다
TEST_DB_NAME=gilit_test

# GA4 Data API (서버 전용 ADC, JSON 파일을 쓸 때는 파일 경로)
GA4_PROPERTY_ID=
GA4_COLLECTION_START_DATE=
GOOGLE_APPLICATION_CREDENTIALS=
