KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
GEMINI_API_KEY=
SECRET_KEY=

# 백엔드 출발시각 엔진 (backend/app/config.py). backend/.env 또는 이 루트 .env에서 읽는다
# mock | kakao. kakao는 위 KAKAO_REST_API_KEY로 카카오모빌리티 미래 운행 정보 API를 쓴다
ROUTE_PROVIDER=mock
DEPARTURE_MAX_CALLS=8
DEPARTURE_SEARCH_WINDOW_MIN=360
# 카카오 요약 조회 캐시와 경로 비교(/api/routes) 응답 캐시 유지 시간(초). 0이면 캐시하지 않는다
ROUTE_CACHE_TTL_SEC=600
# 경로 비교 옵션과 카드 순서 (recommend,time,distance,free 중에서). 비우면 4개 모두
ROUTE_COMPARE_OPTIONS=
# 경로 비교의 옵션 하나당 소요시간 조회 상한
ROUTE_COMPARE_MAX_CALLS=6
# 웹 API를 부를 수 있는 프론트 출처 (쉼표 구분). 비우면 http://localhost:5500,http://127.0.0.1:5500
# POST·PATCH·DELETE의 출처 검사도 이 목록과 같은 호스트(개발은 http://localhost:8000)만 허용한다
CORS_ORIGINS=

# 회원 인증 (backend/app/auth). 개발 주소는 http://localhost:8000으로 통일한다
# 회원·세션 저장소: memory(기본, 서버를 다시 시작하면 사라짐) | mysql(아래 DB_* 필요)
AUTH_STORE=memory
# 세션 쿠키(gilit_session)의 Secure 속성. 비우면 true. 로컬 http에서 쿠키가 안 실리면 false (운영은 반드시 true)
COOKIE_SECURE=
# SECRET_KEY(맨 위): 서명용 비밀 값. 3단계(OAuth state 쿠키)부터 필수
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"

# MySQL 접속 정보 (AUTH_STORE=mysql). 로컬 MySQL과 RDS는 이 값만 바꾸면 된다 (db/README.md)
# 계정은 root가 아니라 서비스 계정(gilit_app, SELECT·INSERT·UPDATE·DELETE만)을 쓴다
DB_HOST=
DB_PORT=3306
DB_NAME=gilit
DB_USER=gilit_app
DB_PASSWORD=
# RDS에서 TLS로 연결할 때 CA 번들 경로 (예: C:/certs/global-bundle.pem). 로컬은 비운다
DB_SSL_CA=
# pytest -m mysql_live 전용 DB. 테스트가 회원 데이터를 지우므로 이름이 _test로 끝나야 하고 DB_NAME과 달라야 한다
TEST_DB_NAME=gilit_test
