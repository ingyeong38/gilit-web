KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
GEMINI_API_KEY=
SECRET_KEY=

# 백엔드 출발시각 엔진 (backend/app/config.py). backend/.env 또는 이 루트 .env에서 읽는다
# mock | kakao. kakao는 위 KAKAO_REST_API_KEY로 카카오모빌리티 미래 운행 정보 API를 쓴다
ROUTE_PROVIDER=mock
DEPARTURE_MAX_CALLS=8
DEPARTURE_SEARCH_WINDOW_MIN=360
# 카카오 요약 조회 캐시와 경로 비교(/api/routes) 응답 캐시 유지 시간(초). 0이면 캐시하지 않는다
ROUTE_CACHE_TTL_SEC=600
# 경로 비교 옵션과 카드 순서 (recommend,time,distance,free 중에서). 비우면 4개 모두
ROUTE_COMPARE_OPTIONS=
# 경로 비교의 옵션 하나당 소요시간 조회 상한
ROUTE_COMPARE_MAX_CALLS=6
# 웹 API를 부를 수 있는 프론트 출처 (쉼표 구분). 비우면 http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=
