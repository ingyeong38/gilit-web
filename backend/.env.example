# 이 파일을 backend/.env로 복사한 후 실제 값을 직접 입력한다.
# 기존 backend/.env가 있으면 덮어쓰지 말고 필요한 항목만 추가한다.
# 환경변수 > backend/.env > 루트 .env 순으로 적용된다.
# 필수 공통값: SECRET_KEY는 안전한 무작위 비밀값으로 생성한다.
SECRET_KEY=
# 로컬 입력값: http://localhost:8000 (콜백 경로는 붙이지 않는다)
OAUTH_REDIRECT_BASE=

# Google Cloud Console > Google Auth Platform > Clients > 웹 애플리케이션
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao Developers > 앱 > 플랫폼 키 > REST API 키
# 지도 JavaScript 키와 다르다. 해당 REST API 키의 Client Secret을 함께 입력한다.
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=

# 비워두면 false. 실제 인증에는 false를 사용한다. 테스트를 위해 켜지 않는다.
OAUTH_MOCK=
# 비워두면 true. HttpOnly/SameSite=Lax는 서버에서 설정한다.
# localhost HTTP 쿠키 저장·전송은 브라우저에서 검증한다. 운영은 반드시 true.
COOKIE_SECURE=

# 기존 DB 설정이 있으면 그대로 유지한다.
# 기본 memory는 서버 재시작 시 계정·세션이 사라진다.
# 영구 저장은 AUTH_STORE=mysql과 아래 접속 정보 및 기존 DB 스키마가 필요하다.
AUTH_STORE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_CA=
